+/// Diagnostics and protocol output must never be a crash site.
+///
+/// `println!` and `eprintln!` panic when the underlying write fails, and
+/// `[profile.release]` sets `panic = "abort"`, so with a consumer that has gone
+/// away -- a `| head -1`, a shell that exited, a Quickshell that was restarted
+/// -- every single log line aborts the process and dumps core instead of
+/// exiting. A `--version` piped into `head` is exactly that, and it left a
+/// SIGABRT core behind.
+///
+/// Restoring `SIGPIPE` to `SIG_DFL` was the alternative, and is rejected. Rust
+/// ignores `SIGPIPE` at startup so that a write to a closed socket surfaces as
+/// `io::ErrorKind::BrokenPipe` rather than killing the process; this helper
+/// serves HTTPS uploads to LocalSend peers that disconnect mid-transfer, so
+/// making every socket write a potential process kill would trade a rare crash
+/// for a common one. Dropping the error on the two diagnostic streams fixes the
+/// crash without changing how the network paths report failure.
+macro_rules! diag {
+    ($($arg:tt)*) => {{
+        use std::io::Write as _;
+        let _ = writeln!(std::io::stderr(), $($arg)*);
+    }};
+}
+
