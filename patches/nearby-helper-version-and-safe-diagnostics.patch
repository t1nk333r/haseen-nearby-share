+/// What this process was asked to do, decided from argv before anything else
+/// happens.
+///
+/// There was no argument parsing at all: `main` was the daemon, so
+/// `omarchy-nearby-helper --version` ignored the flag and started the full
+/// receiver -- selecting interfaces, binding port 53317 and announcing this
+/// machine on every interface it found, a tailnet interface included. Asking a
+/// binary what version it is must never put the machine on a network, so this
+/// runs before the Tokio runtime is built, before the TLS identity is loaded
+/// and before any socket exists.
+///
+/// Nothing in the plugin uses this path: `Service.qml` learns the helper
+/// version from the `helperVersion` field of the `ready` event
+/// (`Model.helperSatisfies` checks it against the manifest's floor), which is
+/// the better source because it reports the binary that is actually running.
+/// `--version` exists for a human at a terminal, and now answers without side
+/// effects.
+enum Invocation {
+    Run,
+    Version,
+    Help,
+    Unrecognised(String),
+}
+
+fn invocation<I: IntoIterator<Item = String>>(args: I) -> Invocation {
+    for arg in args {
+        return match arg.as_str() {
+            "--version" | "-V" => Invocation::Version,
+            "--help" | "-h" => Invocation::Help,
+            other => Invocation::Unrecognised(other.to_string()),
+        };
+    }
+    Invocation::Run
+}
+
+const USAGE: &str = "\
+omarchy-nearby-helper -- the LocalSend engine behind the Nearby Share plugin
+
+Usage:
+  omarchy-nearby-helper            run the receiver and speak JSON over stdio
+  omarchy-nearby-helper --version  print the version and exit
+  omarchy-nearby-helper --help     print this message and exit
+
+With no arguments this is a daemon, not a command: it binds the LocalSend port,
+announces this machine on every multicast-capable interface, and exchanges
+newline-delimited JSON with its parent over stdin and stdout. It is normally
+started by the Quickshell plugin rather than by hand.
+
+Environment:
+  HOSTNAME  the alias advertised to other devices, read once at startup
+  HOME      required; the TLS identity and receiver settings live under it";
+
+fn main() -> Result<()> {
+    match invocation(std::env::args().skip(1)) {
+        Invocation::Run => run(),
+        Invocation::Version => {
+            // Not println!: the caller may well be a `| head -1`, which is the
+            // pipe that used to abort this process. See the diag! macro.
+            use std::io::Write as _;
+            let _ = writeln!(std::io::stdout(), "{}", env!("CARGO_PKG_VERSION"));
+            Ok(())
+        }
+        Invocation::Help => {
+            use std::io::Write as _;
+            let _ = writeln!(std::io::stdout(), "{USAGE}");
+            Ok(())
+        }
+        Invocation::Unrecognised(argument) => {
+            diag!("omarchy-nearby-helper: unrecognised argument `{argument}`");
+            diag!("{USAGE}");
+            std::process::exit(2)
+        }
+    }
+}
