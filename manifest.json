{
  "schemaVersion": 1,
  "id": "haseen.nearby-share",
  "name": "Nearby Share",
  "version": "1.2.1-dev",
  "minHelperVersion": "1.2.0",
  "author": "t1nk33r",
  "description": "Send and receive with LocalSend",
  "homepage": "https://github.com/t1nk333r/haseen-nearby-share",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Nearby Share",
    "description": "Send and receive over LocalSend",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "settings": {
    "receiverEnabled": {
      "type": "boolean",
      "default": true,
      "description": "Run the LocalSend receiver"
    },
    "deviceNameMode": {
      "type": "string",
      "default": "hostname",
      "description": "Where the advertised name comes from: hostname, generated or custom"
    },
    "deviceName": {
      "type": "string",
      "default": "",
      "description": "The advertised name when deviceNameMode is custom"
    }
  }
}
