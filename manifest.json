{
  "schemaVersion": 1,
  "id": "t1nk33r.nearby-share",
  "name": "Nearby Share",
  "version": "1.2.0",
  "minHelperVersion": "1.2.0",
  "author": "t1nk33r",
  "description": "LocalSend and Quick Share in one panel, switched by two buttons",
  "homepage": "https://github.com/jfg96/omarchy-nearby",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Nearby Share",
    "description": "Send and receive over LocalSend or Quick Share",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "settings": {
    "receiverEnabled": {
      "type": "boolean",
      "default": true,
      "description": "Run the LocalSend receiver"
    },
    "mode": {
      "type": "string",
      "default": "localsend",
      "description": "Which pane opens first: localsend or quickshare"
    }
  }
}
