+fn emit(value: serde_json::Value) {
+    println!("{value}");
+}
+
+fn emit_request(id: &str, m: Option<&TransferMetadata>) {
+    let (sender, pin, files, size) = summarize(m);
+    let payload = match m.and_then(|m| m.payload.as_ref()) {
+        Some(TransferPayload::Text(_)) => "text",
+        Some(TransferPayload::Url(_)) => "url",
+        Some(TransferPayload::Wifi { .. }) => "wifi",
+        _ => "files",
+    };
+    emit(json!({
+        "event": "request",
+        "id": id,
+        "sender": sender,
+        "payload": payload,
+        "files": files,
+        "total": size,
+        "pin": pin,
+    }));
+}
+
+fn transfer_file_names(m: Option<&TransferMetadata>) -> Vec<String> {
+    match m.and_then(|m| m.payload.as_ref()) {
+        Some(TransferPayload::Files(v)) => v.clone(),
+        Some(TransferPayload::Text(_)) => vec!["<text>".into()],
+        Some(TransferPayload::Url(_)) => vec!["<url>".into()],
+        Some(TransferPayload::Wifi { .. }) => vec!["<wifi credentials>".into()],
+        None => Vec::new(),
+    }
+}
